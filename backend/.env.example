# Port for the backend API server
API_PORT=8080

# Primary LLM API Key
# Supports:
# - Google Gemini: AI Studio key (e.g. AQ.Ab8...)
# - Groq: High-speed inference (e.g. gsk_...)
# - Leave empty or 'dummy_key_for_testing' to use built-in mock schema generator
LLM_API_KEY=your_llm_api_key_here

# Optional: Dedicated Groq API Key for automatic rate-limit fallback
# If Gemini hits rate limits (HTTP 429), the backend seamlessly fails over to Groq
GROQ_API_KEY=your_groq_api_key_here
